Table enterprise [headercolor: #1F77B4] {
  id varchar [pk, note: "ID"]
  name varchar [note: "名称"]
  category varchar [note: "分類"]
  status varchar [note: "状態"]
  description varchar [note: "説明"]
  specification varchar [note: "仕様"]
  value decimal [note: "数量"]
  unit varchar [note: "単位"]
  location varchar [note: "場所"]
  created_at datetime [note: "登録日時"]
  updated_at datetime [note: "更新日時"]
  created_by varchar [note: "作成者"]
  approved_by varchar [note: "承認者"]
  remark varchar [note: "備考"]
  Note: "事業者: 自社および取引先となる企業を表す。"
}

