  specification varchar [note: "仕様"]
  value decimal [note: "数量"]
  unit varchar [note: "単位"]
  location varchar [note: "場所"]
  due_at datetime [note: "納期"]
  release_at datetime [note: "発行日時"]
  start_at datetime [note: "着手日時"]
  end_at datetime [note: "完了日時"]
  unit_price decimal [note: "単価"]
  price decimal [note: "金額"]
  created_at datetime [note: "登録日時"]
  updated_at datetime [note: "更新日時"]
  created_by varchar [note: "作成者"]
  approved_by varchar [note: "承認者"]
  remark varchar [note: "備考"]
  Note: "購買明細: 仕入先への個々の注文内容を表す。"
}

Table purchase_specification [headercolor: #6B8E23] {
  id varchar [pk, note: "ID"]
  name varchar [note: "名称"]
  category varchar [note: "分類"]
  status varchar [note: "状態"]
  description varchar [note: "説明"]
  supplier_id varchar [ref: > supplier.id, note: "仕入先ID"]
  specification varchar [note: "仕様"]
  value decimal [note: "数量"]
  unit varchar [note: "単位"]
  created_at datetime [note: "登録日時"]
  updated_at datetime [note: "更新日時"]
  created_by varchar [note: "作成者"]
  approved_by varchar [note: "承認者"]
  remark varchar [note: "備考"]
  Note: "購買仕様: 仕入先ごとの購買条件・仕様を表す。"
}

Table purchase_invoice [headercolor: #6B8E23] {
  id varchar [pk, note: "ID"]
  name varchar [note: "名称"]
  category varchar [note: "分類"]
  status varchar [note: "状態"]
  description varchar [note: "説明"]
  supplier_id varchar [ref: > supplier.id, note: "仕入先ID"]
  receiving_result_id varchar [ref: > receiving_result.id, note: "入荷実績ID"]
  specification varchar [note: "仕様"]
  value decimal [note: "数量"]
  unit varchar [note: "単位"]
  unit_price decimal [note: "単価"]
  price decimal [note: "金額"]
  invoice_at datetime [note: "請求日時"]
  payment_at datetime [note: "支払日時"]
  created_at datetime [note: "登録日時"]
  updated_at datetime [note: "更新日時"]
  created_by varchar [note: "作成者"]
  approved_by varchar [note: "承認者"]
  remark varchar [note: "備考"]
  Note: "購買請求: 仕入先から受け取る請求情報を表す。"
}

Table purchase_forecast [headercolor: #6B8E23] {
  id varchar [pk, note: "ID"]
  name varchar [note: "名称"]
  category varchar [note: "分類"]
  status varchar [note: "状態"]
  description varchar [note: "説明"]
  purchase_item_id varchar [ref: > purchase_item.id, note: "購買品目ID"]
  specification varchar [note: "仕様"]
  value decimal [note: "数量"]
  unit varchar [note: "単位"]
  forecast_at datetime [note: "内示日時"]
  created_at datetime [note: "登録日時"]
  updated_at datetime [note: "更新日時"]
  created_by varchar [note: "作成者"]
  approved_by varchar [note: "承認者"]
  remark varchar [note: "備考"]
  Note: "仕入内示: 仕入先への仕入予測通知を表す。"
}

Table purchase_quotation [headercolor: #6B8E23] {
  id varchar [pk, note: "ID"]
  name varchar [note: "名称"]
  category varchar [note: "分類"]
  status varchar [note: "状態"]
  description varchar [note: "説明"]
  supplier_id varchar [ref: > supplier.id, note: "仕入先ID"]
  purchase_item_id varchar [ref: > purchase_item.id, note: "購買品目ID"]
  specification varchar [note: "仕様"]
  value decimal [note: "数量"]
  unit varchar [note: "単位"]
  unit_price decimal [note: "単価"]
  price decimal [note: "金額"]
  due_at datetime [note: "納期"]
  quotation_at datetime [note: "見積日時"]
  created_at datetime [note: "登録日時"]
  updated_at datetime [note: "更新日時"]
  created_by varchar [note: "作成者"]
  approved_by varchar [note: "承認者"]
  remark varchar [note: "備考"]
  Note: "購買見積: 仕入先への見積依頼と回答を表す。"
}

Table receiving_result [headercolor: #6B8E23] {
  id varchar [pk, note: "ID"]
  name varchar [note: "名称"]
  category varchar [note: "分類"]
  status varchar [note: "状態"]
  description varchar [note: "説明"]
  purchase_order_id varchar [ref: > purchase_order.id, note: "購買オーダID"]
  specification varchar [note: "仕様"]
  value decimal [note: "数量"]
  unit varchar [note: "単位"]
  location varchar [note: "場所"]
  result_at datetime [note: "結果日時"]
  created_at datetime [note: "登録日時"]
  updated_at datetime [note: "更新日時"]
  created_by varchar [note: "作成者"]
  approved_by varchar [note: "承認者"]
  remark varchar [note: "備考"]
  Note: "入荷明細: 購買品目の入荷結果を表す。"
}

