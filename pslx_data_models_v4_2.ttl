@prefix : <https://iv-i.or.jp/ontology/pslx#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://iv-i.or.jp/ontology/pslx>
    a owl:Ontology ;
    rdfs:label "PSLX Ontology"@en ;
    owl:versionInfo "1.0" .

:Hierarchy 
    a owl:Class ;
    :hasChildHierarchy :Hierarchy ;
    :consistsOf :Asset.

:Product 
    a owl:Class ;
    :tradeItem :ProductionItem ;
    :hasQuotation :Quotation .

:Asset 
    a owl:Class ;
    :hasChildStructure :Structure ;
    :hasSpecification :Specification ;
    :hasFunction :Function ;
    :hasPortion :Portion ;
    :hasDocument :Document ; 
    :hasIssue :Issue ;
    :hasMonitoringContent :Content ;
    :hasMonitoringResult :Result .

:Group 
    a owl:Class ;
    :hasChildGroup :Structure ;
    :hasCapacity :Capacity .

:Structure 
    a owl:Class ;
    :hasParentStructure :Asset ;
    :hasParentGroup :Group .

:Specification 
    a owl:Class .

:Function 
    a owl:Class .

:Portion 
    a owl:Class .

:Document 
    a owl:Class .

:Issue 
    a owl:Class ;
    :hasCountermeasure :Countermeasure .

:Countermeasure 
    a owl:Class .

:Process 
    a owl:Class ;
    :hasOperation :Operation ;
    :hasPerformance :Performance ;
    :createOf :Asset .

:Operation 
    a owl:Class ;
    :hasContent :Content .

:Content 
    a owl:Class ;
    :hasResult :Result .

:Result 
    a owl:Class .

:Assignment 
    a owl:Class ;
    :assignAsset :Asset ;
    :assignOf :Operation .

:Capacity 
    a owl:Class .

:Order 
    a owl:Class ;
    :orderOf :Process ;
    :hasSchedule :Schedule .

:Schedule 
    a owl:Class ;
    :useAsset :Asset ;
    :scheduleResult :Result.

:Performance 
    a owl:Class ;
    :termOf :Term .

:Company 
    a owl:Class .

:Plan 
    a owl:Class ;
    :plannedForTerm :Term ;
    :inHierarchy :Hierarchy ;
    :inGroup :Group .

:OrderDocument 
    a owl:Class ;
    :orderFrom :Company ;
    :hasOrderContent :OrderContent ;
    :hasInvoice :Invoice ;
    :informForecast :Forecast .

:OrderContent 
    a owl:Class ;
    rdfs:subClassOf :Order .

:Invoice 
    a owl:Class .

:Forecast 
    a owl:Class .

:Quotation 
    a owl:Class .

:Calendar 
    a owl:Class ;
    :hasTerm :Term .

:Term 
    a owl:Class .

# ============================================================
# ObjectProperty
# ============================================================

:consistsOf
    a owl:ObjectProperty ;
    rdfs:domain :Hierarchy ;
    rdfs:range :Asset .

:hasChildStructure
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Structure .

:hasChildHierarchy
    a owl:ObjectProperty ;
    rdfs:domain :Hierarchy ;
    rdfs:range :Hierarchy .
    
:hasParentStructure
    a owl:ObjectProperty ;
    rdfs:domain :Structure ;
    rdfs:range :Asset .
    
:hasChildGroup
    a owl:ObjectProperty ;
    rdfs:domain :Group ;
    rdfs:range :Structure .

:hasParentGroup
    a owl:ObjectProperty ;
    rdfs:domain :Structure ;
    rdfs:range :Group .

:hasSpecification
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Specification .

:hasFunction
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Function .

:hasPortion
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Portion .

:hasDocument
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Document .

:hasIssue
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Issue .

:hasCountermeasure
    a owl:ObjectProperty ;
    rdfs:domain :Issue ;
    rdfs:range :Countermeasure .

:hasOperation
    a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Operation .

:hasContent
    a owl:ObjectProperty ;
    rdfs:domain :Operation ;
    rdfs:range :Content .

:hasResult
    a owl:ObjectProperty ;
    rdfs:domain :Content ;
    rdfs:range :Result .

:scheduleResult
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Result .

:activateResult
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Result .

:resultOf
    a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :Schedule .

:assignAsset
    a owl:ObjectProperty ;
    rdfs:domain :Assignment ;
    rdfs:range :Asset .

:assignOf
    a owl:ObjectProperty ;
    rdfs:domain :Assignment ;
    rdfs:range :Operation .

:orderOf
    a owl:ObjectProperty ;
    rdfs:domain :Order ;
    rdfs:range :Process .

:hasSchedule
    a owl:ObjectProperty ;
    rdfs:domain :Order ;
    rdfs:range :Schedule .

:useAsset
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Asset .

:hasPerformance
    a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Performance .

:termOf
    a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Term .

:orderFrom
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :Company .

:hasMonitoringContent 
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Content .

:hasMonitoringResult 
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Result .

:isContentOf
    a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :Content .

:plannedForTerm
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Term .

:inHierarchy
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Hierarchy .

:inGroup
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Group .

:hasCapacity
    a owl:ObjectProperty ;
    rdfs:domain :Group ;
    rdfs:range :Capacity .

:hasOrderContent
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :OrderContent .

:hasInvoice
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :Invoice .

:informForecast
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :Forecast .

:hasForecast
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :Forecast .

:hasQuotation
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :Quotation .

:hasTerm
    a owl:ObjectProperty ;
    rdfs:domain :Calendar ;
    rdfs:range :Term .

:capacityTermOf
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Term .

:tradeItem 
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :ProductionItem .

# =================================
# sub class
# =================================

:Enterprise
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :hasChildHierarchy :Site .

:Site
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :hasChildHierarchy :Area .

:Area
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :hasChildHierarchy :ProductionLine .

:ProductionLine
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :consistsOf :Personnel ;
    :consistsOf :Equipment .

:ProductionPlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :plannedForTerm :Term ;
    :inGroup :ProductionItemGroup .

:CapacityPlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :capacityTermOf :Term ;
    :inGroup :ProductionItemGroup .

:SalesPlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :plannedForTerm :Term ;
    :inHierarchy :Enterprise ;
    :inGroup :ProductionItemGroup .

:PurchasePlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :plannedForTerm :Term ;
    :inHierarchy :Enterprise ;
    :inGroup :ProductionItemGroup .

# ========================================================================

:AssetGroup 
    a owl:Class ;
    rdfs:subClassOf :Group ;
    :hasChildGroup :AssetStructure .

:AssetStructure 
    a owl:Class ;
    rdfs:subClassOf :Structure ;
    :hasParentStructure :Asset ;
    :hasParentGroup :AssetGroup .

:AssetSpecification 
    a owl:Class ;
    rdfs:subClassOf :Specification .    

:MonitoringContent 
    a owl:Class ;
    rdfs:subClassOf :Content .

:MonitoringResult 
    a owl:Class ;
    rdfs:subClassOf :Result ;
    :isContentOf :MonitoringContent .

# ========================================================================

:ProductionItem 
    a owl:Class ;
    rdfs:subClassOf :Asset ;
    :hasChildStructure :ProductionItemStructure ;
    :hasSpecification :ProductionItemSpecification ;
    :hasFunction :ProductionItemFunction ;
    :hasPortion :ProductionItemPortion ;
    :activateResult :ProductionItemResult .

:ProductionItemGroup 
    a owl:Class ;
    rdfs:subClassOf :Group .

:ProductionItemStructure 
    a owl:Class ;
    rdfs:subClassOf :Structure .

:ProductionItemFunction 
    a owl:Class ;
    rdfs:subClassOf :Function .

:ProductionItemSpecification 
    a owl:Class ;
