:ProductionResult 
    a owl:Class ;
    rdfs:subClassOf :Result .

:ProductionDocument 
    a owl:Class ;
    rdfs:subClassOf :Document .

:ProductionIssue 
    a owl:Class ;
    rdfs:subClassOf :Issue .

:ProductionCountermeasure 
    a owl:Class ;
    rdfs:subClassOf :Countermeasure .

