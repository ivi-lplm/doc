:PurchaseForecast 
    a owl:Class ;
    rdfs:subClassOf :Forecast .

:PurchaseQuotation 
    a owl:Class ;
    rdfs:subClassOf :Quotation .

:ReceivingResult 
    a owl:Class ;
    rdfs:subClassOf :Result .

