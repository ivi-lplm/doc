@prefix : <https://iv-i.or.jp/ontology/pslx#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://iv-i.or.jp/ontology/pslx>
    a owl:Ontology ;
    rdfs:label "PSLX Ontology"@en ;
    owl:versionInfo "1.0" .

:Hierarchy 
    a owl:Class ;
    :hasChildHierarchy :Hierarchy ;
    :consistsOf :Asset.

:Product 
    a owl:Class ;
    :tradeItem :ProductionItem ;
    :hasQuotation :Quotation .

:Asset 
    a owl:Class ;
    :hasChildStructure :Structure ;
    :hasSpecification :Specification ;
    :hasFunction :Function ;
    :hasPortion :Portion ;
    :hasDocument :Document ; 
    :hasIssue :Issue ;
    :hasMonitoringContent :Content ;
    :hasMonitoringResult :Result .

:Group 
    a owl:Class ;
    :hasChildGroup :Structure ;
    :hasCapacity :Capacity .

:Structure 
    a owl:Class ;
    :hasParentStructure :Asset ;
    :hasParentGroup :Group .

:Specification 
    a owl:Class .

:Function 
    a owl:Class .

:Portion 
    a owl:Class .

:Document 
    a owl:Class .

:Issue 
    a owl:Class ;
    :hasCountermeasure :Countermeasure .

:Countermeasure 
    a owl:Class .

:Process 
    a owl:Class ;
    :hasOperation :Operation ;
    :hasPerformance :Performance ;
    :createOf :Asset .

:Operation 
    a owl:Class ;
    :hasContent :Content .

:Content 
    a owl:Class ;
    :hasResult :Result .

:Result 
    a owl:Class .

:Assignment 
    a owl:Class ;
    :assignAsset :Asset ;
    :assignOf :Operation .

:Capacity 
    a owl:Class .

:Order 
    a owl:Class ;
    :orderOf :Process ;
    :hasSchedule :Schedule .

:Schedule 
    a owl:Class ;
    :useAsset :Asset ;
    :scheduleResult :Result.

:Performance 
    a owl:Class ;
    :termOf :Term .

:Company 
    a owl:Class .

:Plan 
    a owl:Class ;
    :plannedForTerm :Term ;
    :inHierarchy :Hierarchy ;
    :inGroup :Group .

:OrderDocument 
    a owl:Class ;
    :orderFrom :Company ;
    :hasOrderContent :OrderContent ;
    :hasInvoice :Invoice ;
    :informForecast :Forecast .

:OrderContent 
    a owl:Class ;
    rdfs:subClassOf :Order .

:Invoice 
    a owl:Class .

:Forecast 
    a owl:Class .

:Quotation 
    a owl:Class .

:Calendar 
    a owl:Class ;
    :hasTerm :Term .

:Term 
    a owl:Class .

# ============================================================
# ObjectProperty
# ============================================================

:consistsOf
    a owl:ObjectProperty ;
    rdfs:domain :Hierarchy ;
    rdfs:range :Asset .

:hasChildStructure
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Structure .

:hasChildHierarchy
    a owl:ObjectProperty ;
    rdfs:domain :Hierarchy ;
    rdfs:range :Hierarchy .
    
:hasParentStructure
    a owl:ObjectProperty ;
    rdfs:domain :Structure ;
    rdfs:range :Asset .
    
:hasChildGroup
    a owl:ObjectProperty ;
    rdfs:domain :Group ;
    rdfs:range :Structure .

:hasParentGroup
    a owl:ObjectProperty ;
    rdfs:domain :Structure ;
    rdfs:range :Group .

:hasSpecification
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Specification .

:hasFunction
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Function .

:hasPortion
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Portion .

:hasDocument
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Document .

:hasIssue
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Issue .

:hasCountermeasure
    a owl:ObjectProperty ;
    rdfs:domain :Issue ;
    rdfs:range :Countermeasure .

:hasOperation
    a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Operation .

:hasContent
    a owl:ObjectProperty ;
    rdfs:domain :Operation ;
    rdfs:range :Content .

:hasResult
    a owl:ObjectProperty ;
    rdfs:domain :Content ;
    rdfs:range :Result .

:scheduleResult
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Result .

:activateResult
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Result .

:resultOf
    a owl:ObjectProperty ;
    owl:inverseOf :scheduleResult ;
    rdfs:domain :Result ;
    rdfs:range :Schedule .

:assignAsset
    a owl:ObjectProperty ;
    rdfs:domain :Assignment ;
    rdfs:range :Asset .

:assignOf
    a owl:ObjectProperty ;
    rdfs:domain :Assignment ;
    rdfs:range :Operation .

:orderOf
    a owl:ObjectProperty ;
    rdfs:domain :Order ;
    rdfs:range :Process .

:hasSchedule
    a owl:ObjectProperty ;
    rdfs:domain :Order ;
    rdfs:range :Schedule .

:useAsset
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Asset .

:hasPerformance
    a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Performance .

:termOf
    a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Term .

:orderFrom
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :Company .

:hasMonitoringContent 
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Content .

:hasMonitoringResult 
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Result .

:isContentOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasResult ;
    rdfs:domain :Result ;
    rdfs:range :Content .

:plannedForTerm
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Term .

:inHierarchy
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Hierarchy .

:inGroup
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Group .

:hasCapacity
    a owl:ObjectProperty ;
    rdfs:domain :Group ;
    rdfs:range :Capacity .

:hasOrderContent
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :OrderContent .

:hasInvoice
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :Invoice .

:informForecast
    a owl:ObjectProperty ;
    rdfs:domain :OrderDocument ;
    rdfs:range :Forecast .

:hasForecast
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :Forecast .

:hasQuotation
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :Quotation .

:hasTerm
    a owl:ObjectProperty ;
    rdfs:domain :Calendar ;
    rdfs:range :Term .

:capacityTermOf
    a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Term .

:tradeItem 
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :ProductionItem .

# ============================================================
# Inverse ObjectProperty
# dbmlの物理FKは「子（明細/付帯情報）テーブル → 親テーブル」の向きで
# 張られるため、上記の抽象プロパティ（親→子）に対する逆方向プロパティを
# owl:inverseOf で明示的に定義する。
# ============================================================

:isSpecificationOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasSpecification ;
    rdfs:domain :Specification ;
    rdfs:range :Asset .

:isFunctionOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasFunction ;
    rdfs:domain :Function ;
    rdfs:range :Asset .

:isPortionOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasPortion ;
    rdfs:domain :Portion ;
    rdfs:range :Asset .

:isDocumentOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasDocument ;
    rdfs:domain :Document ;
    rdfs:range :Asset .

:isIssueOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasIssue ;
    rdfs:domain :Issue ;
    rdfs:range :Asset .

:isCountermeasureOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasCountermeasure ;
    rdfs:domain :Countermeasure ;
    rdfs:range :Issue .

:isContentOfOperation
    a owl:ObjectProperty ;
    owl:inverseOf :hasContent ;
    rdfs:domain :Content ;
    rdfs:range :Operation .

:isOperationOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasOperation ;
    rdfs:domain :Operation ;
    rdfs:range :Process .

:isPerformanceOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasPerformance ;
    rdfs:domain :Performance ;
    rdfs:range :Process .

:isScheduleOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasSchedule ;
    rdfs:domain :Schedule ;
    rdfs:range :Order .

:isCapacityOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasCapacity ;
    rdfs:domain :Capacity ;
    rdfs:range :Group .

:isMonitoringContentOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasMonitoringContent ;
    rdfs:domain :Content ;
    rdfs:range :Asset .

:isMonitoringResultOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasMonitoringResult ;
    rdfs:domain :Result ;
    rdfs:range :Asset .

:isOrderContentOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasOrderContent ;
    rdfs:domain :OrderContent ;
    rdfs:range :OrderDocument .

:isForecastOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasForecast ;
    rdfs:domain :Forecast ;
    rdfs:range :Product .

:isQuotationOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasQuotation ;
    rdfs:domain :Quotation ;
    rdfs:range :Product .

:isCalendarTermOf
    a owl:ObjectProperty ;
    owl:inverseOf :hasTerm ;
    rdfs:domain :Term ;
    rdfs:range :Calendar .

:isActivateResultOf
    a owl:ObjectProperty ;
    owl:inverseOf :activateResult ;
    rdfs:domain :Result ;
    rdfs:range :Asset .

:belongsToHierarchy
    a owl:ObjectProperty ;
    owl:inverseOf :consistsOf ;
    rdfs:domain :Asset ;
    rdfs:range :Hierarchy .

:isCreatedBy
    a owl:ObjectProperty ;
    owl:inverseOf :createOf ;
    rdfs:domain :Asset ;
    rdfs:range :Process .

# ============================================================
# Additional ObjectProperty
# dbmlのFKのうち、上記の抽象プロパティ体系では表現できなかった
# 関係（グループ直接参照、Capacity/Calendarのterm・site参照、
# 販売・購買・在庫の連鎖参照など）を、同じ命名・定義ルールで追加する。
# ============================================================

:belongsToGroup
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Group .

:belongsToParentGroup
    a owl:ObjectProperty ;
    rdfs:domain :Group ;
    rdfs:range :Group .

:processGroup
    a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Group .

:operationGroup
    a owl:ObjectProperty ;
    rdfs:domain :Operation ;
    rdfs:range :Group .

:issueGroup
    a owl:ObjectProperty ;
    rdfs:domain :Issue ;
    rdfs:range :Group .

:performanceGroup
    a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Group .

:issueProcess
    a owl:ObjectProperty ;
    rdfs:domain :Issue ;
    rdfs:range :Process .

:documentProcess
    a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Process .

:capacityTerm
    a owl:ObjectProperty ;
    rdfs:domain :Capacity ;
    rdfs:range :Term .

:capacitySite
    a owl:ObjectProperty ;
    rdfs:domain :Capacity ;
    rdfs:range :Hierarchy .

:capacityAsset
    a owl:ObjectProperty ;
    rdfs:domain :Capacity ;
    rdfs:range :Asset .

:resultTerm
    a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :Term .

:calendarSite
    a owl:ObjectProperty ;
    rdfs:domain :Calendar ;
    rdfs:range :Hierarchy .

:orderAsset
    a owl:ObjectProperty ;
    rdfs:domain :Order ;
    rdfs:range :Asset .

:relatedOrder
    a owl:ObjectProperty ;
    rdfs:domain :Order ;
    rdfs:range :Order .

:scheduleLocation
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Hierarchy .

:scheduleOperation
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Operation .

:productLocation
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :Hierarchy .

:resultProduct
    a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :Product .

:scheduleTransfer
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Performance .

:scheduleProduct
    a owl:ObjectProperty ;
    rdfs:domain :Schedule ;
    rdfs:range :Product .

:performanceProduct
    a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Product .

:orderPortion
    a owl:ObjectProperty ;
    rdfs:domain :Order ;
    rdfs:range :Portion .

:performancePortion
    a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Portion .

:productCompany
    a owl:ObjectProperty ;
    rdfs:domain :Product ;
    rdfs:range :Company .

:invoiceCompany
    a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :Company .

:invoiceResult
    a owl:ObjectProperty ;
    rdfs:domain :Invoice ;
    rdfs:range :Result .

:orderContentProduct
    a owl:ObjectProperty ;
    rdfs:domain :OrderContent ;
    rdfs:range :Product .

:specificationProduct
    a owl:ObjectProperty ;
    rdfs:domain :Specification ;
    rdfs:range :Product .

:quotationCompany
    a owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :Company .

:resultOrderContent
    a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :OrderContent .

:extendsAsset
    a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Asset .

# =================================
# sub class
# =================================

:Enterprise
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :hasChildHierarchy :Site .

:Site
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :hasChildHierarchy :Area .

:Area
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :hasChildHierarchy :ProductionLine .

:ProductionLine
    a owl:Class ;
    rdfs:subClassOf :Hierarchy ;
    :consistsOf :Personnel ;
    :consistsOf :Equipment .

:ProductionPlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :plannedForTerm :Term ;
    :inGroup :ProductionItemGroup .

:CapacityPlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :capacityTermOf :Term .
    # inGroup は EquipmentGroup / PersonnelGroup の両方を対象とするため、
    # 単一クラスに限定せず Plan 基底の :inGroup :Group を継承する。

:SalesPlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :plannedForTerm :Term ;
    :inHierarchy :Enterprise ;
    :inGroup :ProductionItemGroup .

:PurchasePlan 
    a owl:Class ;
    rdfs:subClassOf :Plan ;
    :plannedForTerm :Term ;
    :inHierarchy :Enterprise ;
    :inGroup :ProductionItemGroup .

# ========================================================================

:AssetGroup 
    a owl:Class ;
    rdfs:subClassOf :Group ;
    :hasChildGroup :AssetStructure .

:AssetStructure 
    a owl:Class ;
    rdfs:subClassOf :Structure ;
    :hasParentStructure :Asset ;
    :hasParentGroup :AssetGroup .

:AssetSpecification 
    a owl:Class ;
    rdfs:subClassOf :Specification .    

:MonitoringContent 
    a owl:Class ;
    rdfs:subClassOf :Content .

:MonitoringResult 
    a owl:Class ;
    rdfs:subClassOf :Result ;
    :isContentOf :MonitoringContent .

# ========================================================================

:ProductionItem 
    a owl:Class ;
