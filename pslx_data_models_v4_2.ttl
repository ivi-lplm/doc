:ProductionItemCountermeasure 
    a owl:Class ;
    rdfs:subClassOf :Countermeasure .

:ProductionItemResult 
    a owl:Class ;
    rdfs:subClassOf :Result .

# ========================================================================

:ProductionProcess 
    a owl:Class ;
    rdfs:subClassOf :Process ;
    :createOf :ProductionItem .

:createOf 
    a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Asset .

:ProductionOperation 
    a owl:Class ;
    rdfs:subClassOf :Operation .

:ProductionContent 
    a owl:Class ;
    rdfs:subClassOf :Content .

:ProductionAssignment 
    a owl:Class ;
    rdfs:subClassOf :Assignment .

:ProductionCapacity 
    a owl:Class ;
    rdfs:subClassOf :Capacity .

:ProductionOrder 
    a owl:Class ;
    rdfs:subClassOf :Order .

:ProductionSchedule 
    a owl:Class ;
    rdfs:subClassOf :Schedule .

:ProductionPerformance 
    a owl:Class ;
    rdfs:subClassOf :Performance .

:ProductionResult 
    a owl:Class ;
    rdfs:subClassOf :Result .

:ProductionDocument 
    a owl:Class ;
    rdfs:subClassOf :Document .

:ProductionIssue 
    a owl:Class ;
    rdfs:subClassOf :Issue .

:ProductionCountermeasure 
    a owl:Class ;
    rdfs:subClassOf :Countermeasure .

